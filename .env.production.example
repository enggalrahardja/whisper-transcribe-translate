# Copy to .env.production and adjust for the Ubuntu host.
# NEXT_PUBLIC_API_BASE_URL is embedded into browser assets during pnpm build.
APP_ENV=production
WEB_ORIGIN=https://whisper.example.com
NEXT_PUBLIC_API_BASE_URL=https://whisper.example.com
NEXT_PUBLIC_LIVE_AUDIO_TRANSPORT=legacy
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=whisper_transcribe_translate
STORAGE_ROOT=/var/lib/whisper-transcribe-translate/storage
APP_DEBUG=false
SECURITY_AUTH_ENABLED=true
# Generate a random token; this placeholder is intentionally rejected at startup.
SECURITY_TOKENS_JSON={"replace-with-random-token-at-least-32-characters":{"userId":"admin","role":"admin"}}
SECURITY_TRUSTED_ORIGINS=https://whisper.example.com
SECURITY_REQUIRE_HTTPS=true
SECURITY_PROFILE=Private
RATE_SESSION_CREATE_PER_MINUTE=10
RATE_WEBSOCKET_CONNECT_PER_MINUTE=20
RATE_AUDIO_BYTES_PER_SECOND=128000
RATE_GLOSSARY_RELOAD_PER_MINUTE=2
RATE_MONITORING_PER_MINUTE=30
LIMIT_CONCURRENT_SESSIONS=8
LIMIT_SESSION_DURATION_SECONDS=14400
LIMIT_AUDIO_CHUNK_BYTES=524288
LIMIT_QUEUE_DEPTH=256
LIMIT_UPLOAD_BYTES=1073741824
LIMIT_RECONNECT_ATTEMPTS=20
WEBSOCKET_IDLE_TIMEOUT_SECONDS=30
WEBSOCKET_HEARTBEAT_SECONDS=10
RETENTION_SESSION_METADATA_DAYS=90
RETENTION_AUDIO_DAYS=30
RETENTION_TRANSCRIPT_DAYS=90
RETENTION_TRANSLATION_DAYS=90
RETENTION_METRICS_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_CLEANUP_BATCH_SIZE=500
WHISPER_MODEL_DIR=storage/models/whisper
WHISPER_DOWNLOAD_TIMEOUT_SECONDS=30
WHISPER_DOWNLOAD_MAX_RETRIES=2
WHISPER_DOWNLOAD_HEARTBEAT_SECONDS=5
WHISPER_DOWNLOAD_STALE_SECONDS=60
WHISPER_DOWNLOAD_POLL_SECONDS=1
LIVE_PCM_STREAMING_ENABLED=false
LIVE_PCM_MAX_BUFFER_SECONDS=10
LIVE_PCM_TRANSCRIPTION_WINDOW_SECONDS=3
LIVE_PCM_MAX_SESSIONS=128
LIVE_PCM_MAX_SEQUENCE_GAP=128
LIVE_VAD_ENABLED=false
LIVE_VAD_SPEECH_THRESHOLD=0.6
LIVE_VAD_SILENCE_DURATION_MS=600
LIVE_VAD_PRE_SPEECH_DURATION_MS=300
LIVE_VAD_MINIMUM_SPEECH_DURATION_MS=250
LIVE_VAD_MAXIMUM_SEGMENT_DURATION_MS=20000
LIVE_VAD_SEGMENT_OVERLAP_MS=500
LIVE_VAD_WEBRTC_MODE=2
LIVE_TRANSCRIPT_STATE_ENABLED=false
NEXT_PUBLIC_LIVE_TRANSCRIPT_STATE_ENABLED=false
LIVE_ACCURATE_FINAL_ENABLED=false
LIVE_FINAL_MODEL=base
LIVE_FINAL_DEVICE=auto
LIVE_FINAL_COMPUTE_TYPE=auto
LIVE_FINAL_BEAM_SIZE=5
LIVE_FINAL_TIMEOUT_SECONDS=30
LIVE_FINAL_MAX_RETRIES=1
LIVE_FINAL_WORKER_CONCURRENCY=1
LIVE_FINAL_QUEUE_CAPACITY=128
LIVE_GLOSSARY_ENABLED=false
LIVE_GLOSSARY_PATH=config/glossary.development.json
LIVE_GLOSSARY_PROMPT_MAX_TERMS=64
LIVE_TRANSLATION_ENABLED=false
NEXT_PUBLIC_LIVE_TRANSLATION_ENABLED=false
LIVE_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-id-en
LIVE_TRANSLATION_MODEL_REVISION=main
LIVE_TRANSLATION_SOURCE_LANGUAGE=id
LIVE_TRANSLATION_TARGET_LANGUAGE=en
LIVE_TRANSLATION_DEVICE=auto
LIVE_TRANSLATION_COMPUTE_TYPE=auto
LIVE_TRANSLATION_BEAM_SIZE=4
LIVE_TRANSLATION_TIMEOUT_SECONDS=20
LIVE_TRANSLATION_MAX_RETRIES=1
LIVE_TRANSLATION_WORKER_CONCURRENCY=1
LIVE_TRANSLATION_QUEUE_CAPACITY=64
LIVE_TRANSLATION_CONTEXT_SEGMENTS=3
LIVE_TRANSLATION_QUALITY_ENABLED=false
NEXT_PUBLIC_LIVE_TRANSLATION_QUALITY_ENABLED=false
LIVE_TRANSLATION_QUALITY_TIMEOUT_SECONDS=2
LIVE_TRANSLATION_QUALITY_MAX_RETRIES=1
LIVE_TRANSLATION_QUALITY_WORKER_CONCURRENCY=1
LIVE_TRANSLATION_QUALITY_QUEUE_CAPACITY=64
LIVE_DIARIZATION_ENABLED=false
NEXT_PUBLIC_LIVE_DIARIZATION_ENABLED=false
LIVE_DIARIZATION_MODEL=speechbrain/spkrec-ecapa-voxceleb
LIVE_DIARIZATION_MODEL_REVISION=main
LIVE_DIARIZATION_DEVICE=auto
LIVE_DIARIZATION_COMPUTE_TYPE=auto
LIVE_DIARIZATION_SIMILARITY_THRESHOLD=0.72
LIVE_DIARIZATION_LOW_CONFIDENCE_THRESHOLD=0.65
LIVE_DIARIZATION_TIMEOUT_SECONDS=30
LIVE_DIARIZATION_MAX_RETRIES=1
LIVE_DIARIZATION_WORKER_CONCURRENCY=1
LIVE_DIARIZATION_QUEUE_CAPACITY=64
LIVE_TRANSCRIPT_POSTPROCESS_ENABLED=false
NEXT_PUBLIC_LIVE_TRANSCRIPT_POSTPROCESS_ENABLED=false
LIVE_TRANSCRIPT_POSTPROCESS_FILLER_MODE=preserve
LIVE_TRANSCRIPT_POSTPROCESS_FILLER_WORDS=uh,um,erm,hmm,eh,anu,eee,mmm
LIVE_TRANSCRIPT_POSTPROCESS_PARAGRAPH_SENTENCES=3
LIVE_TRANSCRIPT_POSTPROCESS_TIMEOUT_SECONDS=2
LIVE_TRANSCRIPT_POSTPROCESS_MAX_RETRIES=1
LIVE_TRANSCRIPT_POSTPROCESS_WORKER_CONCURRENCY=1
LIVE_TRANSCRIPT_POSTPROCESS_QUEUE_CAPACITY=64
LIVE_PROCESSING_WORKER_CONCURRENCY=1
LIVE_PROCESSING_WORKER_QUEUE_CAPACITY=32
LIVE_PROCESSING_WORKER_TIMEOUT_MS=30000
LIVE_PIPELINE_PERSISTENCE_ENABLED=false
LIVE_PIPELINE_PERSISTENCE_QUEUE_CAPACITY=256
LIVE_PIPELINE_PERSISTENCE_MAX_RETRIES=2

# Optional production tuning. One API worker is safest for in-process WebSocket state.
API_WORKERS=1

# Optional cloud transcription. Keep local unless external-audio consent is approved.
LIVE_TRANSCRIPTION_PROVIDER=local
LIVE_FINAL_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EXTERNAL_AUDIO_CONSENT=false
OPENAI_ALLOW_LOCAL_FALLBACK=false
