# Copy to .env.production and adjust for the Ubuntu host.
# NEXT_PUBLIC_API_BASE_URL is embedded into browser assets during pnpm build.
APP_ENV=production
WEB_ORIGIN=https://whisper.example.com
NEXT_PUBLIC_API_BASE_URL=https://whisper.example.com
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=whisper_transcribe_translate
STORAGE_ROOT=/var/lib/whisper-transcribe-translate/storage
WHISPER_MODEL_DIR=storage/models/whisper
WHISPER_DOWNLOAD_TIMEOUT_SECONDS=30
WHISPER_DOWNLOAD_MAX_RETRIES=2
WHISPER_DOWNLOAD_HEARTBEAT_SECONDS=5
WHISPER_DOWNLOAD_STALE_SECONDS=60
WHISPER_DOWNLOAD_POLL_SECONDS=1

# Optional production tuning. One API worker is safest for in-process WebSocket state.
API_WORKERS=1
