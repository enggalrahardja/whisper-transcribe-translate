APP_ENV=production
RELEASE_PROFILE=production-hybrid
APP_DEBUG=false
SECURITY_AUTH_ENABLED=true
SECURITY_TOKENS_JSON={"replace-with-32-character-token":{"userId":"replace-user","role":"admin"}}
SECURITY_TRUSTED_ORIGINS=https://transcription.example.com
SECURITY_REQUIRE_HTTPS=true
WEB_ORIGIN=https://transcription.example.com
LIVE_TRANSCRIPTION_PROVIDER=openai
LIVE_FINAL_PROVIDER=openai
LIVE_PCM_STREAMING_ENABLED=true
LIVE_VAD_ENABLED=true
LIVE_TRANSCRIPT_STATE_ENABLED=true
LIVE_ACCURATE_FINAL_ENABLED=true
OPENAI_API_KEY=replace-from-server-secret-manager
OPENAI_EXTERNAL_AUDIO_CONSENT=true
OPENAI_ALLOW_LOCAL_FALLBACK=false
# Template values are deliberately rejected until real secrets/origins/models are supplied.
