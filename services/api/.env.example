APP_NAME=Whisper Transcribe & Translate API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=whisper_transcribe_translate
STORAGE_ROOT=storage
APP_DEBUG=false
# Development remains authentication-free; enable and populate tokens to test production auth.
SECURITY_AUTH_ENABLED=false
SECURITY_TOKENS_JSON={}
SECURITY_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURITY_REQUIRE_HTTPS=false
SECURITY_PROFILE=Fast
LIMIT_CONCURRENT_SESSIONS=8
LIMIT_SESSION_DURATION_SECONDS=14400
LIMIT_AUDIO_CHUNK_BYTES=524288
LIMIT_UPLOAD_BYTES=1073741824
LIMIT_RECONNECT_ATTEMPTS=20
WEBSOCKET_IDLE_TIMEOUT_SECONDS=30
WEBSOCKET_HEARTBEAT_SECONDS=10
WHISPER_MODEL_DIR=storage/models/whisper
WHISPER_DOWNLOAD_TIMEOUT_SECONDS=30
WHISPER_DOWNLOAD_MAX_RETRIES=2
WHISPER_DOWNLOAD_HEARTBEAT_SECONDS=5
WHISPER_DOWNLOAD_STALE_SECONDS=60
WHISPER_DOWNLOAD_POLL_SECONDS=1
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_STALE_AFTER_SECONDS=60
